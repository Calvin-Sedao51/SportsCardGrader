# Copy to e2e/.env (gitignored). Every value is optional.

# Real Google sign-in (10-google-signin.sh). The same OAuth Web client ID is
# used by the server (AUTH_GOOGLE_CLIENT_ID) and the web build (VITE_GOOGLE_CLIENT_ID);
# http://localhost:5173 must be an Authorized JavaScript origin on that client.
# E2E_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Live grading instead of the mocked /api/scan (costs money on your AI account).
# E2E_LIVE_AI=1
# E2E_AI_PROVIDER=anthropic
# E2E_AI_KEY=sk-ant-...
# E2E_CARD_IMAGE=/absolute/path/to/a/real/card-photo.jpg

# Secret the local server signs app tokens with; token sign-in mints with it too.
# AUTH_JWT_SECRET=e2e-local-secret-do-not-deploy

# E2E_BROWSER=chrome          # unset = bundled Chromium; chrome / msedge = installed browser; firefox / webkit
# E2E_SESSION=cardgrader      # playwright-cli session name
# E2E_BASE_URL=http://localhost:5173
# E2E_API_URL=http://localhost:8000
